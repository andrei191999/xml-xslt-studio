#!/bin/sh
# Maven Wrapper Script (Unix)
set -e

MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

DISTRIBUTION_URL=$(grep '^distributionUrl=' "$WRAPPER_PROPERTIES" | cut -d= -f2-)

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_HOME="$MAVEN_USER_HOME/wrapper"

DIST_FILE=$(basename "$DISTRIBUTION_URL")
DIST_NAME="${DIST_FILE%.zip}"
DIST_DIR="$MAVEN_WRAPPER_HOME/dists/$DIST_NAME"

if [ ! -f "$DIST_DIR/$DIST_NAME/bin/mvn" ]; then
    mkdir -p "$DIST_DIR"
    echo "[mvnw] Downloading Maven 3.9.9 from Maven Central..."
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$DIST_DIR/$DIST_FILE" "$DISTRIBUTION_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$DIST_DIR/$DIST_FILE" "$DISTRIBUTION_URL"
    else
        echo "[mvnw] ERROR: Neither curl nor wget found. Install Maven manually." >&2
        exit 1
    fi
    unzip -q "$DIST_DIR/$DIST_FILE" -d "$DIST_DIR"
    rm "$DIST_DIR/$DIST_FILE"
    echo "[mvnw] Maven downloaded to $DIST_DIR"
fi

MVN_BIN=$(find "$DIST_DIR" -maxdepth 2 -name "mvn" -type f | head -1)
if [ -z "$MVN_BIN" ]; then
    echo "[mvnw] ERROR: Could not locate mvn in $DIST_DIR" >&2
    exit 1
fi

exec "$MVN_BIN" "$@"
